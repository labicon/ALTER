# Copy this file to .codiff.local.env and edit CODIFF_DATA_ROOT for each machine.
# .codiff.local.env is git-ignored and should contain only local settings.

export CODIFF_DATA_ROOT="${CODIFF_DATA_ROOT:-/path/to/ALTER-artifacts}"
export CHECKPOINT_ROOT="${CHECKPOINT_ROOT:-$CODIFF_DATA_ROOT/checkpoints/arm}"
export ROLLOUT_ROOT="${ROLLOUT_ROOT:-$CODIFF_DATA_ROOT/envs/arm/data_gen/rollouts}"
export RESULTS_ROOT="${RESULTS_ROOT:-$PWD/public-validation/results}"
export DEBUG_ROOT="${DEBUG_ROOT:-$PWD/public-validation/debug}"
export WANDB_DIR="${WANDB_DIR:-$PWD/public-validation/wandb}"
export LOGS_ROOT="${LOGS_ROOT:-$PWD/public-validation/logs}"

# Use python from the active environment, or set an absolute interpreter path.
export PYTHON_BIN="${PYTHON_BIN:-python}"
